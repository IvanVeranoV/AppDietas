{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Uvicorn: FastAPI/FastAPI App",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "src.main:app",
        "--host",
        "0.0.0.0",
        "--port",
        "8000",
        "--reload"
      ],
      "jinja": true,
      "envFile": "${workspaceFolder}/.env"
    }
  ]
}